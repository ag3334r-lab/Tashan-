# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# =========================================================================
# CLOUDINARY MULTI-ACCOUNT POOL (AUTOMATIC FAILOVER & LOAD BALANCING)
# If Account 1 limit or quota finishes, it automatically shifts to Account 2, then 3, then 4.
# =========================================================================
# --- Account 1 (Primary) ---
CLOUDINARY_CLOUD_NAME=tashan_media
CLOUDINARY_API_KEY=327429844321381
CLOUDINARY_UPLOAD_PRESET=tashan_videos_preset

# --- Account 2 (Failover / Backup 1) ---
CLOUDINARY_CLOUD_NAME_2=tashan_media_2
CLOUDINARY_API_KEY_2=287637381421832
CLOUDINARY_UPLOAD_PRESET_2=tashan_videos_preset_2

# --- Account 3 (Failover / Backup 2) ---
CLOUDINARY_CLOUD_NAME_3=tashan_media_3
CLOUDINARY_API_KEY_3=398471928410293
CLOUDINARY_UPLOAD_PRESET_3=tashan_videos_preset_3

# --- Account 4 (Failover / Backup 3) ---
